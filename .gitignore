# ── Insumos del cliente ───────────────────────────────────────────────
# Material del cliente/referencia: dump de base, manual de marca, uploads, notas,
# repos de referencia (ej. IPG). NO va al repo, a cualquier profundidad.
# Los LEEME.md que explican qué va en cada carpeta ya están trackeados (se agregaron
# a mano con `git add -f`) y siguen versionándose pese a esta regla — git no deja de
# trackear un archivo ya agregado solo porque después empieza a matchear el ignore.
_insumos/

# ── Entorno local de migración (Fase 5) ────────────────────────────────
# Servidor MariaDB local usado para importar dante_wp_legacy (datos reales del
# cliente) y para desarrollo. NUNCA va al repo — mismo criterio que _insumos/.
_local/

# ── Salidas de inventario (pueden contener datos del cliente) ─────────
docs/inventario-crudo.txt
docs/*.csv

# ── Laravel (aparece en la Fase 3, dentro de app/) ────────────────────
app/vendor/
app/node_modules/
app/.env
app/.env.*
