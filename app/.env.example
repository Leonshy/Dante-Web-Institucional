APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

DANTE_ADMIN_PATH=panel
# El 2FA (código por email) es opt-in por usuario desde su perfil — ver
# ADR-003. No hay ninguna variable de entorno que lo fuerce.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Conexión secundaria de SOLO LECTURA al WordPress legacy comprometido, usada
# únicamente por `artisan dante:migrate-wp` (Fase 5, ver docs/07-migracion-wordpress.md).
# El usuario de MySQL debe tener únicamente GRANT SELECT — nunca `root` acá,
# ni siquiera en local. Ver scripts/LEEME.md para cómo crear `wp_lector`.
# DB_LEGACY_HOST=127.0.0.1
# DB_LEGACY_PORT=3306
# DB_LEGACY_DATABASE=dante_wp_legacy
# DB_LEGACY_USERNAME=wp_lector
# DB_LEGACY_PASSWORD=
# DB_LEGACY_PREFIX=tV4yL_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO — Fase 6 (docs/08-seo.md). Los IDs de GA4/GTM/Meta Pixel se cargan desde
# el panel (Integraciones → IntegrationSetting), no acá. Esto es solo lo que
# nunca debe ir al repo.
# DANTE_BLOCK_INDEXING=false (dejar SIN definir en staging: por defecto bloquea
# indexación en todo entorno que no sea `production`; en producción, en `false`
# explícito por variable de entorno, nunca por código — ver config/dante.php).
# DANTE_DEFAULT_OG_IMAGE=

# GA4/GTM, Meta Pixel + Conversions API y Cloudflare Turnstile ya no se
# configuran acá: se cargan desde el panel en "Integraciones"
# (App\Models\IntegrationSetting), con interruptor de activo/inactivo por
# integración — pedido explícito del cliente, nada que dependa de tocar el
# servidor. Ver docs/08-seo.md §6.

# Respaldos (Fase 8, docs/10-seguridad.md §7). `local` es solo para poder
# ejercitar y probar el comando en desarrollo — el destino real fuera del
# servidor (otro disco S3/SFTP del propio Plesk) se define recién en la
# Fase 10, cuando exista el servidor de producción.
BACKUP_DESTINATION_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
