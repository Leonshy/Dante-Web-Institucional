# Plantilla de producción — Fase 10 (docs/12-deploy-plesk.md §3).
# NUNCA copiar el `.env.example` de desarrollo a producción tal cual (tiene
# APP_DEBUG=true, MAIL_MAILER=log, SQLite). Esta plantilla parte de ese mismo
# archivo real del repo, ajustada para el servidor Plesk. Los valores reales
# (contraseñas, APP_KEY, credenciales SMTP) se cargan a mano en el servidor,
# nunca se commitean.

APP_NAME="Colegio Dante Alighieri"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dante.edu.py

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY

# Ruta no adivinable del panel (CLAUDE.md §5, docs/10-seguridad.md §2) —
# nunca "panel" a secas en producción, y nunca la misma que en staging.
DANTE_ADMIN_PATH=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dante_prod
DB_USERNAME=
DB_PASSWORD=

# Sin Redis confirmado en el Plesk (CLAUDE.md §3) — arranca en `database`,
# no cambiar a `redis` sin confirmar antes que el Plesk lo tiene disponible.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.dante.edu.py

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP real del proveedor de correo transaccional del sitio (distinto del
# correo institucional de HostGator, CLAUDE.md §8 — ese no se toca).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@dante.edu.py"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# GA4/GTM, Meta Pixel + Conversions API y Cloudflare Turnstile NO van acá —
# se cargan desde el panel → Integraciones (App\Models\IntegrationSetting,
# secretos cifrados en la base). Ver docs/08-seo.md §6.

# En producción, en `false` EXPLÍCITO por variable — nunca se infiere del
# nombre del entorno para esto (config/dante.php `seo.block_indexing`).
DANTE_BLOCK_INDEXING=false
# Imagen OG de marca (1200×630) — completar cuando exista el diseño
# (docs/08-seo.md §2), si no la imagen de respaldo queda ausente, no rompe nada.
DANTE_DEFAULT_OG_IMAGE=

# Respaldos (docs/10-seguridad.md §7) — destino REAL fuera del propio
# servidor (disco S3/SFTP), nunca `local` en producción: un backup guardado
# en el mismo servidor que falla no sirve de nada.
BACKUP_DESTINATION_DISKS=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
